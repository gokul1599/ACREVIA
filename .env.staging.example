# =============================================================================
# ACREVIA — Staging & Preview Environment Variable Configuration Blueprint
# For Vercel Preview Deployments and Dedicated Staging Infrastructure
# ISOLATION POLICY: NEVER point staging at production databases or production Redis keys.
# 100% Free-Tier & Zero-Cost Architecture Enforced.
# =============================================================================

# Application Core Configuration
PROJECT_NAME="ACREVIA (Staging)"
ENVIRONMENT="staging"
DEBUG=false
PORT=8000
API_V1_PREFIX="/api/v1"
ACREVIA_ENV="staging"

# -----------------------------------------------------------------------------
# 1. Staging Database: Neon PostgreSQL Staging Branch (Zero-Cost Ephemeral Branch)
# -----------------------------------------------------------------------------
# Dedicated staging branch created via Neon CLI / Console:
# neonctl branches create --name staging
# Format: postgresql://<user>:<password>@<ep-staging-domain>/neondb?sslmode=require
# Strictly isolated from the production branch: changes in staging DO NOT affect production.
DATABASE_URL="postgresql://acrevia_staging_user:staging_password@ep-staging-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security & Authentication (Staging Secrets)
JWT_SECRET_KEY="staging_cryptographic_secret_key_minimum_64_characters_long_sha256"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 2. Distributed Rate Limiting: Upstash Redis (Staging Namespace Isolation)
# -----------------------------------------------------------------------------
# Uses dedicated namespace 'acrevia_staging' so staging traffic never pollutes production rate limits.
# Upstash Redis Free Tier: 10,000 commands/day
REDIS_URL="rediss://default:staging_key@blessed-walleye-135278.upstash.io:6379"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_MODE="fail_open"
RATE_LIMIT_NAMESPACE="acrevia_staging"

# -----------------------------------------------------------------------------
# 3. AI Inference: GroqCloud (Free Developer Tier — Preview Model)
# -----------------------------------------------------------------------------
# Uses Free Developer Tier API key (1,000 RPD, 8,000 TPM limit). Zero card attached.
GROQ_API_KEY="gsk_staging_free_developer_key"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_TIMEOUT_SECONDS=10.0

# -----------------------------------------------------------------------------
# 4. Satellite Earth Observation: Element 84 Earth Search + Microsoft Planetary Computer
# -----------------------------------------------------------------------------
# 100% Free, Authentication-Free STAC APIs for Sentinel-2 L2A COGs
EARTH_SEARCH_STAC_URL="https://earth-search.aws.element84.com/v1"
PLANETARY_COMPUTER_STAC_URL="https://planetarycomputer.microsoft.com/api/stac/v1"
SATELLITE_PRIMARY_PROVIDER="earth_search"

# -----------------------------------------------------------------------------
# 5. Open-Meteo Weather API (Open Public — 15-Minute TTL Cache Active)
# -----------------------------------------------------------------------------
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"

# -----------------------------------------------------------------------------
# 6. data.gov.in Agmarknet Mandi Prices (Open Government Data API)
# -----------------------------------------------------------------------------
DATA_GOV_IN_API_KEY="579b464db66ec23bdd000001f1291e67904f46ba5750cf855402dbe3"
DATA_GOV_IN_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"
DATA_GOV_IN_TIMEOUT_SECONDS=10.0

# -----------------------------------------------------------------------------
# 7. Hugging Face Hub (Optional Public Model Discovery)
# -----------------------------------------------------------------------------
HF_TOKEN=""

# -----------------------------------------------------------------------------
# Frontend Client Environment Variables (Publicly Safe Only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV="staging"
NEXT_PUBLIC_API_URL="https://staging-api.acrevia.in"
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"
