# =============================================================================
# ACREVIA Frontend — Environment Configuration Blueprint
# Copy this file to .env.local for local frontend development.
# =============================================================================

# Public API Gateway Base URL
# Option 1 (Direct cross-origin): Point directly to the running backend
# NEXT_PUBLIC_API_URL="http://localhost:8000"
#
# Option 2 (Next.js server rewrite proxy): Leave empty or unset to route requests
# to /api/v1/* via Next.js rewrites to BACKEND_INTERNAL_URL.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Internal Backend Target for Next.js Server-Side Rewrites
# Used when NEXT_PUBLIC_API_URL is empty (relative paths) or during SSR proxying.
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"

# Application Environment Mode (development | staging | production)
NEXT_PUBLIC_APP_ENV="development"
