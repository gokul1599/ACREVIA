# =============================================================================
# ACREVIA — Environment Variable Configuration Blueprint
# Copy this file to .env and configure local secret values.
# NEVER commit .env with real production secrets into version control.
# ALL SERVICES MUST UTILIZE FREE-TIER, COMMUNITY, OR OPEN ACCESS ONLY.
# Updated for Phase 07 / Stage 14 Security Architecture & Testing Pipeline.
# =============================================================================

# Application Core Configuration
PROJECT_NAME="ACREVIA"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
API_V1_PREFIX="/api/v1"

# -----------------------------------------------------------------------------
# 1. Primary Database: Neon PostgreSQL + pgvector (Free Tier: 0.5 GiB, 1 Project)
# -----------------------------------------------------------------------------
# Neon connection string (SSL required in cloud).
# Format: postgresql://<user>:<password>@<ep-pooler-domain>/<dbname>?sslmode=require
# Local SQLite fallback for unit tests: sqlite:///./acrevia_dev.db
DATABASE_URL="sqlite:///./acrevia_dev.db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security & Authentication (JWT + Bcrypt)
JWT_SECRET_KEY="insecure_default_dev_key_replace_in_production_32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# 2. Distributed Rate Limiting: Upstash Redis (Free Tier: 10,000 commands/day)
# -----------------------------------------------------------------------------
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
# Leave empty to use thread-safe in-memory sliding-window fallback
REDIS_URL=""
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_MODE="fail_open"  # "fail_open" prevents outage cascades for rural farmers
RATE_LIMIT_NAMESPACE="acrevia"

# -----------------------------------------------------------------------------
# 3. AI Inference: GroqCloud (Free Tier: 30 RPM, 14,400 TPD on Llama/Qwen)
# -----------------------------------------------------------------------------
# Obtain free developer key from https://console.groq.com/keys
# Supported free models: qwen/qwen3.8-27b, openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_TIMEOUT_SECONDS=12.0

# -----------------------------------------------------------------------------
# 4. Satellite Earth Observation: Element 84 Earth Search + Microsoft Planetary Computer
# -----------------------------------------------------------------------------
# 100% Free, Authentication-Free STAC APIs for Sentinel-2 L2A Cloud-Optimized GeoTIFFs (COGs)
# Primary STAC API: Element 84 Earth Search on AWS Open Data (Zero Auth Required)
EARTH_SEARCH_STAC_URL="https://earth-search.aws.element84.com/v1"
# Secondary Fallback STAC API: Microsoft Planetary Computer (Free Public Catalogue + Anonymous SAS)
PLANETARY_COMPUTER_STAC_URL="https://planetarycomputer.microsoft.com/api/stac/v1"
SATELLITE_PRIMARY_PROVIDER="earth_search"

# Legacy Copernicus CDSE (Optional, Non-Blocking)
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
COPERNICUS_BASE_URL="https://catalogue.dataspace.copernicus.eu/odata/v1"

# -----------------------------------------------------------------------------
# 5. Open Model & Dataset Hub: Hugging Face (Free Tier: Read-Only Hub Access)
# -----------------------------------------------------------------------------
# Generate free User Access Token (Read) at https://huggingface.co/settings/tokens
# HF_TOKEN is strictly optional. Public models and datasets work without a token.
HF_TOKEN=""

# -----------------------------------------------------------------------------
# 6. Agrometeorological Weather: Open-Meteo (Free Public API, No Key Required)
# -----------------------------------------------------------------------------
# Free for non-commercial agricultural research & smallholder use (< 10,000 daily calls)
# Attribution required: "Weather data provided by Open-Meteo.com"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"

# -----------------------------------------------------------------------------
# 7. Agricultural Market Datasets: data.gov.in (National Open Data Portal)
# -----------------------------------------------------------------------------
# Register for free API key at https://data.gov.in
# Resource ID for Agmarknet Daily Mandi Prices & Arrivals: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=""
DATA_GOV_IN_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"
DATA_GOV_IN_TIMEOUT_SECONDS=10.0

# Dedicated ML Inference Microservice & Local Media Storage
ML_INFERENCE_URL="http://localhost:8001"
STORAGE_PROVIDER="LOCAL"
STORAGE_LOCAL_DIR="data/storage"
MAX_IMAGE_SIZE_BYTES=15728640

# -----------------------------------------------------------------------------
# 8. Frontend Client Configuration (Next.js & Vercel)
# -----------------------------------------------------------------------------
# Base URL for API calls from browser/client (leave empty for relative / Next.js proxy)
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Target backend URL for Next.js internal server-side rewrites
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_APP_ENV="development"
