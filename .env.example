# =============================================================================
# ACREVIA — Environment Variable Configuration Blueprint
# Copy this file to .env and configure local secret values.
# NEVER commit .env with real production secrets into version control.
# =============================================================================

# Application Core Configuration
PROJECT_NAME="ACREVIA"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 16)
# Local SQLite development fallback: sqlite:///./acrevia_dev.db
# PostgreSQL Container: postgresql://acrevia_user:acrevia_dev_secret_change_me@localhost:5432/acrevia_db
DATABASE_URL="sqlite:///./acrevia_dev.db"
POSTGRES_USER="acrevia_user"
POSTGRES_PASSWORD="acrevia_dev_secret_change_me"
POSTGRES_DB="acrevia_db"
POSTGRES_PORT=5432

# Security & Authentication (JWT + Bcrypt)
# Generate a secure 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="insecure_default_dev_key_replace_in_production_32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dedicated ML Inference Microservice
ML_INFERENCE_URL="http://localhost:8001"

# Object Storage Settings (Private Foliar Media)
STORAGE_PROVIDER="LOCAL"
STORAGE_LOCAL_DIR="data/storage"
MAX_IMAGE_SIZE_BYTES=15728640

# Third-Party Agrometeorological & Cloud Integrations (Optional/Placeholder)
# OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
# GROQ_API_KEY=""
# GEMINI_API_KEY=""
# HUGGING_FACE_TOKEN=""
# SARVAM_AI_API_KEY=""
# SUPABASE_DB_URL=""
